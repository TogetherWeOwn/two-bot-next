      "id": "V7-ALIAS-GAME-COND-02",
      "clause": "V7-ALIAS-GAME-COND",
      "polarity": "negative",
      "title": "GAME condition does not match an unrelated game",
      "input": {
        "aliases": {"Counter-Strike 2": "CS2"},
        "condition": "GAME:Valorant",
        "member_game": "Counter-Strike 2"
      },
      "expected": {"game_condition_match": false}
