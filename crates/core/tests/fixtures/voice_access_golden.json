      "id": "V7-ALIAS-GAME-COND-01",
      "clause": "V7-ALIAS-GAME-COND",
      "polarity": "positive",
      "title": "GAME condition matches through the alias name",
      "input": {
        "aliases": {"Counter-Strike 2": "CS2"},
        "condition": "GAME:CS2",
