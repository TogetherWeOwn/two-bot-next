        "member_game": "Apex Legends"
      },
      "expected": {"aliases": {"Apex Legends": "Apex"}, "rendered_game": "Apex"}
    },
    {
      "id": "V7-ALIAS-CRUD-02",
      "clause": "V7-ALIAS-CRUD",
      "polarity": "positive",
      "title": "removed alias restores the raw game name",
      "input": {
        "action": "alias_remove",
        "alias": {"raw": "Apex Legends"},
        "aliases_before": {"Apex Legends": "Apex"},
        "member_game": "Apex Legends"
      },
      "expected": {"aliases": {}, "rendered_game": "Apex Legends"}
    },
    {
      "id": "V7-ALIAS-CRUD-03",
      "clause": "V7-ALIAS-CRUD",
      "polarity": "negative",
      "title": "removing one alias leaves the others intact",
      "input": {
        "action": "alias_remove",
        "alias": {"raw": "Apex Legends"},
        "aliases_before": {"Apex Legends": "Apex", "Counter-Strike 2": "CS2"},
        "member_game": "Counter-Strike 2"
      },
      "expected": {"aliases": {"Counter-Strike 2": "CS2"}, "rendered_game": "CS2"}
    },
