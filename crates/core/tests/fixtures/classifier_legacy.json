  "invites": [
    {
      "id": "unknown-offline-join",
      "title": "Join while the bot was down reads unknown, never a guess",
      "why": "Discord replays the member on reconnect but the invite delta is lost (EVENTS.md limit 3). The honest answer is unknown.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "aaa": 5
        },
        "currentUses": [
          {
            "code": "aaa",
            "uses": 5
          }
        ],
        "joinCount": 1,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [
          "unknown"
        ],
        "exact": [
          false
        ]
      },
      "expectCategory": "unknown",
      "growth": {}
    },
    {
      "id": "unknown-discovery-several",
      "title": "Several offline joins are all unknown",
      "why": "Nothing moved, so there is no code to name - not one guess per member, unknown per member.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "a": 2,
          "b": 7
        },
        "currentUses": [
          {
            "code": "a",
            "uses": 2
          },
          {
            "code": "b",
            "uses": 7
          }
        ],
        "joinCount": 3,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [
          "unknown",
          "unknown",
          "unknown"
        ],
        "exact": [
          false,
          false,
          false
        ]
      },
      "expectCategory": "unknown",
      "growth": {}
    },
    {
      "id": "vanity-control",
      "title": "No movement with a vanity URL is vanity, not unknown",
      "why": "Control for the unknown boundary: 'no code moved' alone does not mean unknown - the vanity URL is the probable path.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "a": 2
        },
        "currentUses": [
          {
            "code": "a",
            "uses": 2
          }
        ],
        "joinCount": 2,
        "guildHasVanity": true
      },
      "expect": {
        "sources": [
          "vanity",
          "vanity"
        ],
        "exact": [
          false,
          false
        ]
      },
      "expectCategory": "vanity",
      "growth": {}
    },
    {
      "id": "ambiguous-two-codes-no-close",
      "title": "Two codes moved but the arithmetic does not close: ambiguous",
      "why": "Counters say 3 arrivals, the member list gained 2 - somebody joined and left inside the window. Any per-code split would be a guess printed as a number.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "aaa": 5,
          "bbb": 1
        },
        "currentUses": [
          {
            "code": "aaa",
            "uses": 7
          },
          {
            "code": "bbb",
            "uses": 2
          }
        ],
        "joinCount": 2,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [
          "ambiguous:aaa+bbb",
          "ambiguous:aaa+bbb"
        ],
        "exact": [
          false,
          false
        ]
      },
      "expectCategory": "ambiguous",
      "growth": {
        "aaa": 2,
        "bbb": 1
      }
    },
    {
      "id": "ambiguous-three-codes",
      "title": "Three codes moved without closing: one ambiguous string, not three guesses",
      "why": "The failure mode this guards: splitting 3 members across a+2/b+1/c+1 when only 3 arrived. The codes join with + in sorted order.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "a": 0,
          "b": 0,
          "c": 0
        },
        "currentUses": [
          {
            "code": "a",
            "uses": 2
          },
          {
            "code": "b",
            "uses": 1
          },
          {
            "code": "c",
            "uses": 1
          }
        ],
        "joinCount": 3,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [
          "ambiguous:a+b+c",
          "ambiguous:a+b+c",
          "ambiguous:a+b+c"
        ],
        "exact": [
          false,
          false,
          false
        ]
      },
      "expectCategory": "ambiguous",
      "growth": {
        "a": 2,
        "b": 1,
        "c": 1
      }
    },
    {
      "id": "split-exact-counts-not-ambiguous",
      "title": "Two codes moved and the arithmetic closes: per-code counts, NOT ambiguous",
      "why": "The TOG-5681 distinction. A +2 / B +1 with 3 arrivals is fully determined in aggregate - quoting it as ambiguous would throw away the campaign's per-code join counts.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "aaa": 5,
          "bbb": 1
        },
        "currentUses": [
          {
            "code": "aaa",
            "uses": 7
          },
          {
            "code": "bbb",
            "uses": 2
          }
        ],
        "joinCount": 3,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [
          "invite:aaa",
          "invite:aaa",
          "invite:bbb"
        ],
        "exact": [
          false,
          false,
          false
        ]
      },
      "expectCategory": "invite-placed",
      "growth": {
        "aaa": 2,
        "bbb": 1
      }
    },
    {
      "id": "single-code-exact",
      "title": "One code moved and the count closes: the only exact case",
      "why": "Exactly one code gained exactly the arrivals observed. This - and only this - is proof a member came through that code.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "aB3xY9": 4
        },
        "currentUses": [
          {
            "code": "aB3xY9",
            "uses": 5
          }
        ],
        "joinCount": 1,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [
          "invite:aB3xY9"
        ],
        "exact": [
          true
        ]
      },
      "expectCategory": "invite-exact",
      "growth": {
        "aB3xY9": 1
      }
    },
    {
      "id": "single-code-best-guess",
      "title": "One code moved but two arrived: best guess, not proof",
      "why": "Behaviour is unchanged - the code is still stamped on both - but exact stays false: one of the two did not come through it.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "aB3xY9": 4
        },
        "currentUses": [
          {
            "code": "aB3xY9",
            "uses": 5
          }
        ],
        "joinCount": 2,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [
          "invite:aB3xY9",
          "invite:aB3xY9"
        ],
        "exact": [
          false,
          false
        ]
      },
      "expectCategory": "invite-placed",
      "growth": {
        "aB3xY9": 1
      }
    },
    {
      "id": "new-code-single-no-close",
      "title": "A code created inside the window still claims its uses on the best-guess path",
      "why": "The newest invite is usually the one a growth push is handing out. Fresh has +3 against 1 arrival: single code, no close, so best guess - but the code is named, not dropped.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "old": 4
        },
        "currentUses": [
          {
            "code": "old",
            "uses": 4
          },
          {
            "code": "fresh",
            "uses": 3
          }
        ],
        "joinCount": 1,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [
          "invite:fresh"
        ],
        "exact": [
          false
        ]
      },
      "expectCategory": "invite-placed",
      "growth": {
        "fresh": 3
      }
    },
    {
      "id": "counter-reset-clamp-feeds-exact",
      "title": "A reset code cannot cancel a real rise out of exactness",
      "why": "Deleted-and-recreated codes reset to zero. Unclamped, the -9 would swallow real's +1 and this arrival would read unknown. Clamped, it is the ordinary exact case.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "reset": 9,
          "real": 1
        },
        "currentUses": [
          {
            "code": "reset",
            "uses": 0
          },
          {
            "code": "real",
            "uses": 2
          }
        ],
        "joinCount": 1,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [
          "invite:real"
        ],
        "exact": [
          true
        ]
      },
      "expectCategory": "invite-exact",
      "growth": {
        "real": 1
      }
    },
    {
      "id": "no-members-no-events",
      "title": "Counters moved but nobody arrived: no attributions at all",
      "why": "Uses can move without joins (bot restarts, recounts). A window with no new members emits nothing, whatever the counters did.",
      "kind": "window",
      "scenario": {
        "prevUses": {
          "a": 2
        },
        "currentUses": [
          {
            "code": "a",
            "uses": 9
          }
        ],
        "joinCount": 0,
        "guildHasVanity": false
      },
      "expect": {
        "sources": [],
        "exact": []
      },
      "expectCategory": "invite-placed",
      "growth": {
        "a": 7
      }
    },
