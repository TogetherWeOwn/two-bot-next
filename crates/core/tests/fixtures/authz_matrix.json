    "cases": [
      {"name": "ban_ok", "action": "Ban", "actor": {"id": "1", "perms": 4, "pos": 10}, "target": {"id": "2", "pos": 5}, "bot_pos": 20, "expect": "ok"},
      {"name": "ban_without_bit", "action": "Ban", "actor": {"id": "1", "perms": 2, "pos": 10}, "target": {"id": "2", "pos": 5}, "bot_pos": 20, "expect": "ActorMissingPermission(Ban)"},
      {"name": "administrator_bit_is_not_ban", "action": "Ban", "actor": {"id": "1", "perms": 8, "pos": 10}, "target": {"id": "2", "pos": 5}, "bot_pos": 20, "expect": "ActorMissingPermission(Ban)"},
      {"name": "permission_checked_before_self_target", "action": "Kick", "actor": {"id": "1", "perms": 0, "pos": 10}, "target": {"id": "1", "pos": 5}, "bot_pos": 20, "expect": "ActorMissingPermission(Kick)"},
      {"name": "self_target", "action": "Kick", "actor": {"id": "1", "perms": 2, "pos": 10}, "target": {"id": "1", "pos": 5}, "bot_pos": 20, "expect": "TargetSelf"},
      {"name": "guild_owner_target", "action": "Timeout", "actor": {"id": "1", "perms": 1099511627776, "pos": 10}, "target": {"id": "2", "pos": 1, "owner": true}, "bot_pos": 20, "expect": "TargetGuildOwner"},
      {"name": "owen_target", "action": "Warn", "actor": {"id": "1", "perms": 1099511627776, "pos": 10}, "target": {"id": "900", "pos": 1}, "bot_pos": 20, "expect": "TargetOwen"},
      {"name": "bot_user_target", "action": "Warn", "actor": {"id": "1", "perms": 1099511627776, "pos": 10}, "target": {"id": "901", "pos": 1}, "bot_pos": 20, "expect": "TargetOwen"},
      {"name": "other_bot_target", "action": "Ban", "actor": {"id": "1", "perms": 4, "pos": 10}, "target": {"id": "2", "pos": 1, "bot": true}, "bot_pos": 20, "expect": "TargetBot"},
      {"name": "staff_role_target", "action": "Ban", "actor": {"id": "1", "perms": 4, "pos": 10}, "target": {"id": "2", "pos": 1, "roles": ["staff"]}, "bot_pos": 20, "expect": "TargetStaffRole"},
      {"name": "non_protected_role_target", "action": "Ban", "actor": {"id": "1", "perms": 4, "pos": 10}, "target": {"id": "2", "pos": 1, "roles": ["member"]}, "bot_pos": 20, "expect": "ok"},
      {"name": "bot_hierarchy_equal", "action": "TempBan", "actor": {"id": "1", "perms": 4, "pos": 30}, "target": {"id": "2", "pos": 20}, "bot_pos": 20, "expect": "BotHierarchy"},
      {"name": "bot_hierarchy_checked_before_actor", "action": "TempBan", "actor": {"id": "1", "perms": 4, "pos": 5}, "target": {"id": "2", "pos": 20}, "bot_pos": 20, "expect": "BotHierarchy"},
      {"name": "actor_hierarchy_equal", "action": "TempBan", "actor": {"id": "1", "perms": 4, "pos": 10}, "target": {"id": "2", "pos": 10}, "bot_pos": 20, "expect": "ActorHierarchy"},
      {"name": "actor_below_target", "action": "Kick", "actor": {"id": "1", "perms": 2, "pos": 3}, "target": {"id": "2", "pos": 10}, "bot_pos": 20, "expect": "ActorHierarchy"},
      {"name": "missing_target", "action": "Ban", "actor": {"id": "1", "perms": 4, "pos": 10}, "target": null, "bot_pos": 20, "expect": "MissingTarget"},
      {"name": "purge_needs_no_target", "action": "Purge", "actor": {"id": "1", "perms": 8192, "pos": 1}, "target": null, "bot_pos": 20, "expect": "ok"},
      {"name": "purge_ignores_member_protection", "action": "Purge", "actor": {"id": "1", "perms": 8192, "pos": 1}, "target": {"id": "1", "pos": 99, "owner": true}, "bot_pos": 20, "expect": "ok"},
      {"name": "purge_without_bit", "action": "Purge", "actor": {"id": "1", "perms": 16, "pos": 1}, "target": null, "bot_pos": 20, "expect": "ActorMissingPermission(Purge)"},
      {"name": "slowmode_with_manage_channels", "action": "Slowmode", "actor": {"id": "1", "perms": 16, "pos": 1}, "target": null, "bot_pos": 20, "expect": "ok"},
      {"name": "lockdown_without_bit", "action": "Lockdown", "actor": {"id": "1", "perms": 8192, "pos": 1}, "target": null, "bot_pos": 20, "expect": "ActorMissingPermission(Lockdown)"},
      {"name": "unlock_all_bits", "action": "Unlock", "actor": {"id": "1", "perms": 18446744073709551615, "pos": 1}, "target": null, "bot_pos": 20, "expect": "ok"}
