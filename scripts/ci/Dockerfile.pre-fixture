# Supply the verified predecessor OCI layout by digest as the predecessor context.
FROM python:3.13-slim-trixie@sha256:7249d5587b78209a006dc4a3b5340678f84ea729239193aa559962cd8c1fce50 AS python
FROM postgres:18.6@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722
USER root
WORKDIR /opt/pre
COPY --from=python /usr/local/bin/python3* /usr/local/bin/
COPY --from=python /usr/local/lib/libpython3.13.so* /usr/local/lib/
COPY --from=python /usr/local/lib/python3.13 /usr/local/lib/python3.13
ENV LD_LIBRARY_PATH=/usr/local/lib
COPY --from=predecessor /home/nonroot/two-bot /home/nonroot/two-bot
COPY crates/cutover/migrations crates/cutover/migrations
COPY crates/store/migrations crates/store/migrations
COPY sql/web_v1.sql sql/web_v1.sql
COPY scripts/script_intake.py scripts/
COPY scripts/ci/fixtures/predecessor_*.py scripts/ci/fixtures/
COPY --chmod=0555 scripts/ci/pre_fixture_supervisor.py scripts/ci/
RUN ln -s /opt/pre/scripts/ci/pre_fixture_supervisor.py /opt/pre/run
ENTRYPOINT ["/opt/pre/run"]
CMD []
