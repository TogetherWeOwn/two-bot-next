{
  "name": "staging-automod-preview",
  "on": {"workflow_call": ""},
  "permissions": {},
  "concurrency": {"group": "staging-lifecycle", "cancel-in-progress": "false", "queue": "max"},
  "jobs": {
    "dry-run": {
      "if": "github.workflow_ref == 'TogetherWeOwn/two-bot-next/.github/workflows/staging-automod-preview.yml@refs/heads/main' && github.event_name == 'workflow_dispatch' && github.ref_protected && github.run_attempt == 1",
      "environment": {"name": "staging", "deployment": "false"},
      "permissions": {"contents": "read"},
      "runs-on": "ubuntu-latest",
      "timeout-minutes": "5",
      "steps": [
        {
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {"ref": "${{ github.sha }}", "persist-credentials": "false", "fetch-depth": "1"}
        },
        {
          "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
          "with": {"node-version": "22", "package-manager-cache": "false"}
        },
        {
          "name": "Exercise the AutoMod dry-run job with a synthetic invoker",
          "run": "node --test wrangler/test/staging-automod-workflow.test.ts"
        }
      ]
    }
  }
}
