{
  "name": "staging-predecessor",
  "on": {
    "workflow_dispatch": {
      "inputs": {
        "endpoint": {
          "type": "choice",
          "options": [
            "original-pre",
            "retained-pre"
          ],
          "required": "true"
        }
      }
    }
  },
  "permissions": {},
  "concurrency": {
    "group": "staging-lifecycle",
    "cancel-in-progress": "false",
    "queue": "max"
  },
  "jobs": {
    "qualify": {
      "if": "github.repository_id == '1396224242' && github.ref == 'refs/heads/main' && github.ref_protected && github.run_attempt == 1 && vars.PREDECESSOR_STAGING_ENABLED == 'true'",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": "60",
      "environment": "staging-predecessor",
      "permissions": {
        "actions": "read",
        "checks": "read",
        "contents": "read"
      },
      "steps": [
        {
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {
            "ref": "${{ github.sha }}",
            "persist-credentials": "false",
            "fetch-depth": "0"
          }
        },
        {
          "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
          "with": {
            "node-version": "22",
            "package-manager-cache": "false"
          }
        },
        {
          "name": "Verify exact source and export the reviewed build inputs",
          "env": {
            "GH_TOKEN": "${{ github.token }}"
          },
          "run": "python3 scripts/staging_predecessor.py prepare"
        },
        {
          "name": "Install the archived locked Worker dependencies",
          "working-directory": "${{ runner.temp }}/predecessor/source/wrangler",
          "run": "npm ci"
        },
        {
          "name": "Verify the isolated endpoint, deploy, prove exact takeover and stop",
          "env": {
            "PREDECESSOR_ENDPOINT": "${{ inputs.endpoint }}",
            "PREDECESSOR_WORKER_URL": "${{ vars.PREDECESSOR_WORKER_URL }}",
            "PREDECESSOR_DB_HOST": "${{ vars.PREDECESSOR_DB_HOST }}",
            "PREDECESSOR_DB_NAME": "${{ vars.PREDECESSOR_DB_NAME }}",
            "PREDECESSOR_GUILD_ID": "${{ vars.PREDECESSOR_GUILD_ID }}",
            "PREDECESSOR_RETAINED_FENCE": "${{ vars.PREDECESSOR_RETAINED_FENCE }}",
            "PREDECESSOR_PLAN_URL": "${{ secrets.PREDECESSOR_PLAN_URL }}",
            "PREDECESSOR_RUNTIME_URL": "${{ secrets.PREDECESSOR_RUNTIME_URL }}",
            "PREDECESSOR_DISCORD_TOKEN": "${{ secrets.PREDECESSOR_DISCORD_TOKEN }}",
            "PREDECESSOR_CONTROL_TOKEN": "${{ secrets.PREDECESSOR_CONTROL_TOKEN }}",
            "CLOUDFLARE_ACCOUNT_ID": "${{ secrets.PREDECESSOR_CLOUDFLARE_ACCOUNT_ID }}",
            "CLOUDFLARE_API_TOKEN": "${{ secrets.PREDECESSOR_CLOUDFLARE_API_TOKEN }}"
          },
          "run": "python3 scripts/staging_predecessor.py qualify"
        },
        {
          "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
          "with": {
            "name": "staging-predecessor-${{ github.run_id }}-1",
            "path": "${{ runner.temp }}/predecessor/qualification.json",
            "if-no-files-found": "error",
            "retention-days": "14"
          }
        }
      ]
    }
  }
}
