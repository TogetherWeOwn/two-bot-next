+    def test_production_live_sha_probe_policy_is_pinned_and_mutations_fail(self):
+        # The guard probes live /readyz through a Request carrying the fixed
+        # rollout User-Agent, then compares build_revision to the requested
+        # SHA with exactly one probe. Every softening (dropped User-Agent or
+        # header wiring, retargeted or unwrapped probe, lost timeout, lost
+        # SHA comparison, doubled probe) must fail closed here.
+        production = self.workflows["deploy-production.yml"]
+        self.assertEqual(production_errors(production), [])
+
+        def mutated(change):
+            workflow = deepcopy(production)
+            change(workflow)
+            return production_errors(workflow)
+
+        for pin in ('urllib.request.Request(',
+                    'worker_url + "/readyz"',
+                    'headers=',
+                    '"User-Agent"',
+                    '"two-bot-next-production-rollout/1.0"',
+                    'urllib.request.urlopen(request, timeout=10)',
+                    'live_report.get("build_revision") != sha'):
+            with self.subTest(dropped=pin):
+                def drop(w, pin=pin):
+                    for step in w["jobs"]["guard"]["steps"]:
+                        if "run" in step:
+                            step["run"] = step["run"].replace(pin, "")
+                self.assertTrue(mutated(drop))
+        with self.subTest(dropped="request timeout"):
+            def drop_timeout(w):
+                for step in w["jobs"]["guard"]["steps"]:
+                    if "run" in step:
+                        step["run"] = step["run"].replace(
+                            "urllib.request.urlopen(request, timeout=10)",
+                            "urllib.request.urlopen(request)")
+            self.assertTrue(mutated(drop_timeout))
+        with self.subTest(rewound="bare urlopen"):
+            # Rewinding to urlopen(worker_url + ...) reintroduces the
+            # reviewed edge rejection and must fail closed.
+            def rewind(w):
+                for step in w["jobs"]["guard"]["steps"]:
+                    if "run" in step:
+                        step["run"] = step["run"].replace(
+                            "urllib.request.urlopen(request, timeout=10)",
+                            'urllib.request.urlopen(worker_url + "/readyz", timeout=10)')
+            self.assertTrue(mutated(rewind))
+        with self.subTest(duplicated="second probe"):
+            def duplicate(w):
+                for step in w["jobs"]["guard"]["steps"]:
+                    if "run" in step and "urllib.request.urlopen(request, timeout=10)" in step["run"]:
+                        step["run"] = step["run"].replace(
+                            "urllib.request.urlopen(request, timeout=10)",
+                            "urllib.request.urlopen(request, timeout=10)\n"
+                            "                      with urllib.request.urlopen(request, timeout=10) as response2:\n"
+                            "                          status2, body2 = response2.status, response2.read()")
+            self.assertTrue(mutated(duplicate))
+        with self.subTest(duplicated="second Request"):
+            def duplicate_request(w):
+                for step in w["jobs"]["guard"]["steps"]:
+                    if "run" in step and "urllib.request.Request(" in step["run"]:
+                        step["run"] = step["run"].replace(
+                            "urllib.request.Request(",
+                            "urllib.request.Request(\n"
+                            "                          worker_url + \"/readyz\",\n"
+                            "                          headers={\"User-Agent\": \"two-bot-next-production-rollout/1.0\"},\n"
+                            "                      )\n"
+                            "                      spare = urllib.request.Request(",
+                            1)
+            self.assertTrue(mutated(duplicate_request))
+
