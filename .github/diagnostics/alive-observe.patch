@@ -42,6 +42,82 @@
 const GUILD: &str = "2222";
 const SESSION: &str = "alive-mock-session";
 type Logs = Arc<Mutex<String>>;
+
+// Only the supplemental job applies this patch, to the pinned baseline checkout.
+static EXPERIMENT_CLOCK: std::sync::LazyLock<Instant> = std::sync::LazyLock::new(Instant::now);
+static ACTIVE_TESTS: AtomicUsize = AtomicUsize::new(0);
+
+#[derive(Clone, Copy)]
+struct Trace(&'static str);
+
+struct TestSpan(Trace);
+
+impl Trace {
+    fn start(self) -> TestSpan {
+        self.note(
+            "test_threads",
+            std::thread::available_parallelism().map_or(0, |n| n.get()) as u128,
+        );
+        self.note(
+            "test_enter",
+            (ACTIVE_TESTS.fetch_add(1, SeqCst) + 1) as u128,
+        );
+        TestSpan(self)
+    }
+
+    fn note(self, phase: &'static str, value: u128) {
+        eprintln!(
+            "alive_observe {} {} {} {}",
+            self.0,
+            phase,
+            EXPERIMENT_CLOCK.elapsed().as_micros(),
+            value
+        );
+    }
+
+    fn ready(response: &str) -> u128 {
+        let Some((_, body)) = response.split_once("\r\n\r\n") else {
+            return 0;
+        };
+        let Ok(body) = serde_json::from_str::<Value>(body) else {
+            return 0;
+        };
+        let status = &body["jobs"]["scheduled_events"];
+        if !status.is_object() {
+            return 0;
+        }
+        // Bitset: present, parked, running, start seen, success seen, error seen.
+        1 | (u128::from(status["parked"].as_bool() == Some(true)) << 1)
+            | (u128::from(status["running"].as_bool() == Some(true)) << 2)
+            | (u128::from(status["last_start"].is_u64()) << 3)
+            | (u128::from(status["last_success"].is_u64()) << 4)
+            | (u128::from(status["last_error_class"].is_string()) << 5)
+    }
+
+    async fn watch_ready(self, addr: SocketAddr) {
+        let mut last = None;
+        loop {
+            if let Ok(Ok(response)) = timeout(Duration::from_millis(80), get(addr, "/readyz")).await
+            {
+                let bits = Self::ready(&response);
+                if last != Some(bits) {
+                    self.note("job_state", bits);
+                    last = Some(bits);
+                }
+            }
+            sleep(Duration::from_millis(100)).await;
+        }
+    }
+}
+
+impl Drop for TestSpan {
+    fn drop(&mut self) {
+        self.0.note(
+            "test_leave",
+            (ACTIVE_TESTS.fetch_sub(1, SeqCst) - 1) as u128,
+        );
+    }
+}

